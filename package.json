{
  "name": "video-vortex",
  "version": "0.2.0",
  "description": "Interactive terminal CLI to download videos from popular platforms with resolution/format selection and a full-width progress bar.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "video-vortex": "./dist/cli.js",
    "vv": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "video",
    "download",
    "cli",
    "youtube",
    "instagram",
    "facebook",
    "yt-dlp",
    "terminal",
    "progress-bar",
    "video-vortex"
  ],
  "author": "Jônatas Bueno <jonatas.livramento@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonatasbueno/video-vortex.git"
  },
  "bugs": {
    "url": "https://github.com/jonatasbueno/video-vortex/issues"
  },
  "homepage": "https://github.com/jonatasbueno/video-vortex#readme",
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "execa": "^9.5.2",
    "gradient-string": "^3.0.0",
    "ink": "^5.2.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "youtube-dl-exec": "^3.0.20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.18",
    "@vitest/coverage-v8": "^3.2.4",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
